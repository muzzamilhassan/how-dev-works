  "takeaways": [
    { "t": "every page ≈ 500 sorted keys", "color": "green" },
    { "t": "depth ≈ log₅₀₀(N) → 3–4 hops", "color": "amber" },
    { "t": "one lookup, always fast", "color": "cyan" }
  ],
  "takeawaysBeat": 7,
  "outro": "a billion rows, four hops",
  "beats": [
    { "i": 0, "text": "You ask for one user, by id. Somewhere inside a billion rows." },
    { "i": 1, "text": "Without an index, the database scans the whole table. Row, by row, by row." },
    { "i": 2, "text": "The B-tree changes the game. Every page holds hundreds of sorted keys." },
    { "i": 3, "text": "A lookup starts at the root page, and takes exactly one branch." },
    { "i": 4, "text": "Then exactly one leaf. And the leaf points straight at your row." },
    { "i": 5, "text": "Three hops. Not a billion." },
    { "i": 6, "text": "Because every page fans out hundreds of times, the tree stays almost flat, no matter how much you insert." },
    { "i": 7, "text": "A billion rows. Depth four. That is why databases love B-trees." }
  ]
}
